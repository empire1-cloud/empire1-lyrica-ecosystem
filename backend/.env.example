# Copy to backend/.env and fill in real values. Never commit backend/.env —
# it's already covered by .gitignore. Omni-Agent's own guardrails also
# hard-block **/.env* from being read or written by the agent itself.

# --- Database (optional — app boots fine without it; status-check demo
#     routes and Mongo-backed billing history return 503 until set) ---
MONGO_URL=
DB_NAME=omni_agent

# --- CORS ---
CORS_ORIGINS=*

# --- Stripe (self-serve Pro/Team checkout) ---
# Start in TEST MODE (sk_test_ / whsec_ from a test webhook) and verify the
# full flow before ever putting live keys here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Public base URL of the deployed app, used to build Stripe success/cancel
# redirect URLs, e.g. https://omni-agent.onrender.com
APP_BASE_URL=
