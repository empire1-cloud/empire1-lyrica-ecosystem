# Copy to frontend/.env and fill in real values for local dev. In the
# deploy target, set this as a build-time env var (CRA inlines REACT_APP_*
# vars at build time, not runtime).

# Base URL of the deployed backend, e.g. https://omni-agent-api.onrender.com
# Leave empty for local dev if the frontend dev server proxies /api to a
# backend running on the same host.
REACT_APP_BACKEND_URL=
