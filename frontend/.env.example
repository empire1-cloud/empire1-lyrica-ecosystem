# Copy to frontend/.env and fill in real values for local dev. In the
# deploy target, set this as a build-time env var (CRA inlines REACT_APP_*
# vars at build time, not runtime).

# Base URL of the deployed backend, e.g. https://omni-agent-api.onrender.com
# Leave empty for local dev if the frontend dev server proxies /api to a
# backend running on the same host.
REACT_APP_BACKEND_URL=

# https://github.com/apps/<your-app-slug> — works the moment the GitHub
# App exists and is public (before it's Marketplace-listed). Leave empty
# until you've completed the manifest flow (see backend GET /api/github/app/new).
REACT_APP_GITHUB_APP_INSTALL_URL=

# https://github.com/marketplace/<your-app-slug> — only set this once the
# Marketplace listing is actually approved and live. Setting it switches
# the site's primary CTA and plan-card links from Stripe/direct-install to
# "View on GitHub Marketplace".
REACT_APP_GITHUB_MARKETPLACE_URL=
